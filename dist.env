# postgres-frontend only: enables signed, fresh ascension NFT W/L attestations.
# The public address for this key must be set in game2 contracts as
# ASCENSION_RECORD_SIGNER_ADDRESS. This signer only signs off-chain vouchers and
# does not pay claim gas.
# ASCENSION_RECORD_SIGNER_PRIVATE_KEY=0x...
# ASCENSION_RECORD_ATTESTATION_TTL_SECONDS=600
# Default 0 is fail-closed freshness. Raising this to 1-2 improves availability
# during RPC propagation drift, but can sign against a not-quite-latest indexer.
# ASCENSION_RECORD_MAX_LAG_BLOCKS=0
# ASCENSION_RECORD_RATE_LIMIT_WINDOW_SECONDS=60
# ASCENSION_RECORD_RATE_LIMIT_MAX_REQUESTS=30
# ASCENSION_RECORD_CLAIMANT_RATE_LIMIT_MAX_REQUESTS=6

{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "tags": ["asphodel", "loki", "logs"],
  "title": "Asphodel — Service Logs (Loki)",
  "uid": "asphodel-service-logs",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "query": "label_values({service=~\"indexer-.+|keryx\"}, env)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "level",
        "label": "level",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "query": "label_values({service=~\"indexer-.+|keryx\"}, level)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "search (line contains)",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "indexer-store",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "indexer-store — log volume by level",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "info" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "debug" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "gray" } }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum by (level) (count_over_time({service=\"indexer-store\", env=~\"$env\", level=~\"$level\"} |= \"$search\" [$__auto]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "indexer-store — logs",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 7 },
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "{service=\"indexer-store\", env=~\"$env\", level=~\"$level\"} |= \"$search\" | json | line_format \"{{if .component}}{{.component}} | {{end}}{{.msg}}\"",
          "maxLines": 1000
        }
      ]
    },
    {
      "type": "row",
      "title": "indexer-api",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "indexer-api — log volume by level",

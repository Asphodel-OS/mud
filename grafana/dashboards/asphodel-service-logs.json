          "expr": "{service=\"indexer-api\", env=~\"$env\", level=~\"$level\"} |= \"$search\" | json | line_format \"{{if .component}}{{.component}} | {{end}}{{.msg}}\"",
          "maxLines": 1000
        }
      ]
    },
    {
